# Copiez ce fichier en .env et renseignez vos clés pour activer les vrais services.
# Sans ces variables, l'application fonctionne en MODE DÉMO (localStorage + moteur IA local).

# --- Supabase (auth Google/Email + base de données) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- OpenAI (diagnostic IA réel) ---
# Note : exposer une clé OpenAI côté navigateur n'est PAS recommandé en production.
# Préférez une Edge Function Supabase ou un backend qui proxifie l'appel.
VITE_OPENAI_API_KEY=
